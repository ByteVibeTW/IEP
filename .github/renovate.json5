{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "packageRules": [
        {
            "matchPaths": ["web/**"],
            "groupName": "web dependencies",
            "schedule": ["before 6pm on Friday"],
            "matchUpdateTypes": ["minor", "patch"],
            "automerge": true,
            "automergeType": "pr"
        }
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["before 6pm on Friday"]
    }
}